# OCCA Postgres — same DB as the OCCA server. scan reads only; use a
# read-only PG role on prod if you want hard guarantees.
DATABASE_URL=postgresql://localhost:5432/occa

# Solana RPC. Public devnet is fine for dev but rate-limits hard;
# swap for Helius / QuickNode / Triton on prod.
SOLANA_RPC_URL=https://api.devnet.solana.com
